<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 登录用户上下文过滤器 -->
    <filter>
        <filter-name>LoginFilter</filter-name>
        <filter-class>net.xju.filter.LoginFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoginFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>

    <!-- 跨域过滤器 -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>net.xju.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 前端控制器 -->
    <servlet>
        <servlet-name>MVC</servlet-name>
        <servlet-class>net.xju.common.framework.simplemvc.DispatcherServlet</servlet-class>
        <init-param>
            <param-name>scan-package</param-name>
            <param-value>net.xju.controller</param-value>
        </init-param>
        <init-param>
            <param-name>view-path</param-name>
            <param-value>/page</param-value>
        </init-param>
        <init-param>
            <param-name>suffix</param-name>
            <param-value>jsp</param-value>
        </init-param>
        <load-on-startup>0</load-on-startup>
        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>2097152</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>MVC</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>